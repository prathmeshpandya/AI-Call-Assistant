# Copy to .env (project root) and adjust. Every value shown is the default.
# Relative paths are resolved against the project root.

# --- Backend server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Browser origins allowed to open the WebSocket (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_JSON=false
MAX_SESSIONS=4
WARMUP=true

# --- Local SLM (llama.cpp llama-server, OpenAI-compatible) ---
LLM_BASE_URL=http://127.0.0.1:8080/v1
# Must match llama-server --alias (scripts\start-llm.ps1 uses "local-slm")
LLM_MODEL=local-slm
# Leave empty for llama-server. Only set for an explicitly configured remote provider.
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=300
LLM_CONNECT_TIMEOUT_S=3
LLM_FIRST_TOKEN_TIMEOUT_S=30
LLM_TOTAL_TIMEOUT_S=120
SYSTEM_PROMPT_FILE=backend/prompts/system_prompt.txt

# --- Language (only English models are wired up in v1) ---
LANGUAGE=en

# --- Speech recognition (sherpa-onnx streaming zipformer) ---
STT_PROVIDER=sherpa_streaming
STT_MODEL_DIR=models/sherpa-onnx-streaming-zipformer-en-2023-06-26
# Optional explicit overrides (otherwise auto-discovered in STT_MODEL_DIR):
# STT_ENCODER=
# STT_DECODER=
# STT_JOINER=
# STT_TOKENS=
STT_NUM_THREADS=2
STT_DECODING_METHOD=greedy_search
STT_TAIL_PADDING_MS=500

# --- Voice activity detection and turn-taking ---
VAD_MODEL_PATH=models/silero_vad.onnx
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=200
VAD_MIN_SILENCE_MS=150
PREROLL_MS=500
# Silence after speech that ends the user's turn
END_OF_TURN_SILENCE_MS=700
# Longer wait when the transcript ends in "and", "so", "because", ...
END_OF_TURN_HESITATION_SILENCE_MS=1500
MIN_UTTERANCE_MS=250
MAX_UTTERANCE_S=30

# --- Barge-in (interrupting the assistant) ---
BARGE_IN_ENABLED=true
BARGE_IN_MIN_SPEECH_MS=400
BARGE_IN_MIN_WORDS=2
BARGE_IN_KEYWORDS=stop,wait,hold on,no,sorry,excuse me,hang on

# --- Text-to-speech ---
# piper_sherpa  = fast (default). LJSpeech voice: public-domain dataset.
# kokoro_sherpa = more natural (Apache-2.0) but slower than real time on a Ryzen 5 5500U while the
#                 LLM is generating -> audible gaps between sentences. Use on faster hardware.
TTS_PROVIDER=piper_sherpa
TTS_MODEL_DIR=models/vits-piper-en_US-ljspeech-medium
# Empty = engine default voice
TTS_VOICE=
TTS_SPEED=1.0
TTS_NUM_THREADS=2
# Kokoro:
# TTS_PROVIDER=kokoro_sherpa
# TTS_MODEL_DIR=models/kokoro-en-v0_19
# TTS_VOICE=af_bella   (af af_bella af_nicole af_sarah af_sky am_adam am_michael bf_emma bf_isabella bm_george bm_lewis)
# TTS_NUM_THREADS=4

# --- Audio transport (fixed by the models; validated at startup) ---
AUDIO_INPUT_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_MAX_FRAME_BYTES=32000

# --- Sentence chunking for streaming TTS ---
CHUNK_MIN_CHARS=12
CHUNK_MAX_CHARS=220
CHUNK_FIRST_SOFT_CHARS=30
CHUNK_SOFT_CHARS=40

# --- Conversation memory ---
MAX_HISTORY_TURNS=12
MAX_HISTORY_CHARS=6000
